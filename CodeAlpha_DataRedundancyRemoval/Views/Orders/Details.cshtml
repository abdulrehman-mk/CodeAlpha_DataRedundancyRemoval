@model Order
@{
    ViewData["Title"] = "Order Details";
}

<h1>Order #@Model.Id</h1>

<div class="card mb-3" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderDate)</dt>
            <dd class="col-sm-8">@Model.OrderDate.ToShortDateString()</dd>

            <dt class="col-sm-4">Customer</dt>
            <dd class="col-sm-8">
                @if (Model.Customer != null)
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Customer.Id">@Model.Customer.Name</a>
                }
            </dd>

            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8"><strong>@Model.Total.ToString("C")</strong></dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center">
    <h4>Line items</h4>
    <a asp-controller="OrderDetails" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm btn-primary">+ Add Product</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var detail in Model.OrderDetails) {
        <tr>
            <td>@detail.Product?.Name</td>
            <td>@detail.Quantity</td>
            <td>@detail.UnitPrice.ToString("C")</td>
            <td>@((detail.Quantity * detail.UnitPrice).ToString("C"))</td>
            <td class="text-end">
                <a asp-controller="OrderDetails" asp-action="Edit" asp-route-id="@detail.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-controller="OrderDetails" asp-action="Delete" asp-route-id="@detail.Id" class="btn btn-sm btn-outline-danger">Remove</a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
