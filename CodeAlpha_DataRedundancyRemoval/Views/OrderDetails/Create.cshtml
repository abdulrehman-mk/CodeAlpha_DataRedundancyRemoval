@model OrderDetail
@{
    ViewData["Title"] = "Add Product to Order";
}

<h1>Add Product to Order #@ViewData["OrderId"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <input type="hidden" asp-for="OrderId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UnitPrice" class="form-label"></label>
                <input asp-for="UnitPrice" class="form-control" placeholder="Leave 0 to use the product's current price" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
                <div class="form-text">Leave as 0 to automatically use the product's current price.</div>
            </div>
            <button type="submit" class="btn btn-primary">Add</button>
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@ViewData["OrderId"]" class="btn btn-outline-secondary">Back to order</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
